[Unit]
Description=bizon-slots: Telegram-бот отчётов
After=network-online.target

[Service]
WorkingDirectory=/opt/bizon-slots
EnvironmentFile=-/opt/bizon-slots/.env
EnvironmentFile=-/opt/bizon-slots/settings.env
ExecStart=/opt/bizon-slots/venv/bin/python -m app.report serve
Restart=always
RuntimeMaxSec=21600
RestartSec=5

[Install]
WantedBy=multi-user.target
