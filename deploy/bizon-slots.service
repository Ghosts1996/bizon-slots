[Unit]
Description=bizon-slots (слоты автовебинара для Сейлбота)
After=network.target

[Service]
WorkingDirectory=/opt/bizon-slots
Environment=SLOTS=14,16,19,21
ExecStart=/opt/bizon-slots/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
